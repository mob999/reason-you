{
  "name": "reasonyou",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "CLI tool that explains recent command-line errors with an LLM.",
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun build ./index.ts --compile --outfile dist/reasonyou",
    "build:bun-darwin-x64": "bun build ./index.ts --compile --target=bun-darwin-x64 --outfile dist/reasonyou-bun-darwin-x64",
    "build:bun-darwin-arm64": "bun build ./index.ts --compile --target=bun-darwin-arm64 --outfile dist/reasonyou-bun-darwin-arm64",
    "build:bun-linux-x64": "bun build ./index.ts --compile --target=bun-linux-x64 --outfile dist/reasonyou-bun-linux-x64",
    "build:bun-linux-arm64": "bun build ./index.ts --compile --target=bun-linux-arm64 --outfile dist/reasonyou-bun-linux-arm64",
    "build:bun-windows-x64": "bun build ./index.ts --compile --target=bun-windows-x64 --outfile dist/reasonyou-bun-windows-x64.exe",
    "build:bun-windows-arm64": "bun build ./index.ts --compile --target=bun-windows-arm64 --outfile dist/reasonyou-bun-windows-arm64.exe",
    "build:release": "bun run build:bun-darwin-x64 && bun run build:bun-darwin-arm64 && bun run build:bun-linux-x64 && bun run build:bun-linux-arm64 && bun run build:bun-windows-x64 && bun run build:bun-windows-arm64",
    "check": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "bun test"
  },
  "files": [
    "dist",
    "README.md",
    "install.sh",
    "install.ps1",
    "docs/prd.md"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "openai": "^6.34.0"
  },
  "packageManager": "bun@1.3.13"
}
